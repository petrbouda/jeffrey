<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cafe.jeffrey-analyst</groupId>
        <artifactId>jeffrey-events-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../jeffrey-events-parent/pom.xml</relativePath>
    </parent>

    <artifactId>jeffrey-heartbeat</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Reports JVM liveness to a Jeffrey Hub from inside the application, without a Java agent</description>
    <!-- Explicit: Maven Central rejects children that inherit a url with the artifactId appended. -->
    <url>https://github.com/petrbouda/jeffrey</url>

    <properties>
        <!--
          Lower than its siblings, which need 25 for the Tracer API's ScopedValue. Nothing here
          needs it — this is a scheduled file write — and this library is the only way a JVM
          reports liveness to a hub, so pinning it to 25 would put an application on Java 21
          outside Jeffrey's session tracking entirely.
        -->
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <!--
      One compile dependency, and the list stays that short on purpose: this jar is compiled into
      applications Jeffrey profiles but does not own, so anything it brought along would be a
      version those applications did not choose. slf4j-api is the exception that costs them
      nothing — it is a facade with no implementation, every application that logs already has it,
      and it is what the rest of Jeffrey logs through, so a heartbeat line is routed, formatted and
      filtered by the application's own logging configuration rather than by whatever
      java.util.logging happens to be set to. No binding is declared here; the application's is the
      one that must win.
    -->
    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
          Test scope only: without a binding slf4j falls back to a no-op and announces it on
          stderr on every run. A library never ships one.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

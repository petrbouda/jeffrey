<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey-analyst</groupId>
        <artifactId>jeffrey-jib</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeffrey-jib-payload-jar</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>The provisioner jar baked into application images by the Jeffrey JIB extension.</description>
    <url>https://github.com/petrbouda/jeffrey</url>

    <!--
      Architecture-neutral, so unlike its native sibling this module publishes one plain jar: the
      payload under jeffrey-payload/ plus the holder class Maven Central's sources/javadoc rules
      need. CI stages provisioner.jar into src/main/resources/jeffrey-payload/ before packaging.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>payload-staged</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- A release that forgot to stage the jar must fail here rather
                                     than publish an empty payload that breaks every consumer. -->
                                <requireFilesExist>
                                    <files>
                                        <file>${project.basedir}/src/main/resources/jeffrey-payload/provisioner.jar</file>
                                    </files>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <configuration>
                    <!-- Belt and braces: filtering is off by default, and a filtered jar would be
                         a corrupt jar. -->
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>jar</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

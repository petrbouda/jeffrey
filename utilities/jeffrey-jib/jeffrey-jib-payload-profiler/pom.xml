<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey-analyst</groupId>
        <artifactId>jeffrey-jib</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeffrey-jib-payload-profiler</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>async-profiler libraries baked into application images by the Jeffrey JIB extension.</description>
    <url>https://github.com/petrbouda/jeffrey</url>

    <!--
      One classified jar per architecture, each carrying a single file under jeffrey-payload/.
      CI stages the binaries into src/main/payload/linux-<arch>/jeffrey-payload/ before packaging;
      the directory is not a resource root, so nothing filters or rewrites a binary.

      The main (unclassified) jar carries only the holder class. It exists because Maven Central
      requires a pom plus sources and javadoc jars for every artifact; the extension never resolves
      it, because an arch-scoped payload is always requested with a classifier.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>payload-staged</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- A release that forgot to stage a binary must fail here rather
                                     than publish an empty payload that breaks every consumer. -->
                                <requireFilesExist>
                                    <files>
                                        <file>${project.basedir}/src/main/payload/linux-amd64/jeffrey-payload/libasyncProfiler.so</file>
                                        <file>${project.basedir}/src/main/payload/linux-arm64/jeffrey-payload/libasyncProfiler.so</file>
                                    </files>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <executions>
                    <execution>
                        <id>payload-linux-amd64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>linux-amd64</classifier>
                            <classesDirectory>${project.basedir}/src/main/payload/linux-amd64</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>payload-linux-arm64</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>linux-arm64</classifier>
                            <classesDirectory>${project.basedir}/src/main/payload/linux-arm64</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

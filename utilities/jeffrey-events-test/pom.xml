<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cafe.jeffrey-analyst</groupId>
        <artifactId>jeffrey-events-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../jeffrey-events-parent/pom.xml</relativePath>
    </parent>

    <!--
      Deliberately does not depend on jeffrey-events. It reads spans out of a
      recording by their declared field names, which are the frozen wire format,
      exactly as Jeffrey's own derivation discovers spans structurally - which is
      what lets the jeffrey-events module use this toolkit in its own tests
      without a reactor cycle.

      Jackson is the one dependency, for reading a span's attributes back out of
      the JSON object they are recorded as.
    -->
    <artifactId>jeffrey-events-test</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Test toolkit for asserting Jeffrey JFR events and traces in a real flight recording</description>
    <!-- Explicit: Maven Central rejects children that inherit a url with the artifactId appended. -->
    <url>https://github.com/petrbouda/jeffrey</url>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              No module-info: a test toolkit is consumed from test code, which is
              rarely modularised, and declaring a module here would force every
              consumer's test compilation onto the module path. The automatic
              module name keeps it well-behaved for anyone who does.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>cafe.jeffrey.jfr.events.test</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

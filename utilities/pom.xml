<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>utilities</artifactId>
    <packaging>pom</packaging>

    <!--
        Aggregator for standalone libraries published to Maven Central with their own groupId
        (cafe.jeffrey-analyst). Listing them here means `mvn clean verify` from the monorepo root
        exercises them too; their own <parent> references and release profiles stay independent so
        each library keeps its own coordinate, license, and publishing pipeline.

        jeffrey-events is also *consumed* by the monorepo rather than merely built alongside it: the
        root pom pins jeffrey-events.version to this module's 1.0-SNAPSHOT so the events the
        application records and the events the parser reads come from one source. Editing an
        event type here therefore changes the application; releasing the library is a separate act.

        Only jeffrey-events-parent is listed below, yet the whole family builds: that module is
        the pom-packaged parent of jeffrey-events, jeffrey-events-test and the jeffrey-tracing
        module, itself the parent of the jeffrey-tracing-* instrumentation modules, and it aggregates
        them by relative path. Every one of them is a directory named after the artifact it builds,
        so a published coordinate maps to a path without translation; the parent keeps them on one
        version and one release run, and owns the library's LICENSE, README and JReleaser configuration.
    -->
    <modules>
        <module>jeffrey-events-parent</module>
        <module>jeffrey-jib</module>
    </modules>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cafe.jeffrey-analyst</groupId>
    <artifactId>jeffrey-utilities-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Parent of the Jeffrey libraries applications add to be profiled well: events, heartbeat and tracing</description>
    <url>https://github.com/petrbouda/jeffrey</url>

    <!--
      The root of every library under utilities/ and the one release root: `mvn versions:set`
      and the staging deploy run here, and jreleaser.yml next to this file signs and uploads
      what they stage. It holds only what the families share - the build configuration,
      dependencyManagement, the release profile and the Maven Central metadata - and aggregates
      the libraries, which are independent of one another:
        jeffrey-events/            the JFR event types
        jeffrey-heartbeat-parent/  jeffrey-heartbeat, jeffrey-heartbeat-spring-boot-starter
        jeffrey-tracing-parent/    jeffrey-tracing-api, its two span-context storages
                                   (jeffrey-tracing-scoped-value, jeffrey-tracing-thread-local) and the
                                   jeffrey-tracing-* instrumentation modules, plus the
                                   internal, unpublished jeffrey-tracing-test toolkit
      jeffrey-events and each family parent inherit from this pom only, never from a sibling, so
      one can be reshaped without touching the others. They still release together, on one version.

      Deliberately not a child of the monorepo's parent: this pom is published to Maven Central
      and every library's pom points at it, so it must not reference anything that is not
      published. The monorepo still builds it - the root pom lists `utilities` as a module - and
      pins jeffrey-events.version to this 1.0-SNAPSHOT, so the events the application records
      and the events the parser reads come from one source.

      Every module is a directory named after the artifact it builds, so a published coordinate
      maps to a path without translation.
    -->
    <modules>
        <module>jeffrey-events</module>
        <module>jeffrey-heartbeat-parent</module>
        <module>jeffrey-tracing-parent</module>
    </modules>

    <developers>
        <developer>
            <name>Petr Bouda</name>
            <email>bouda.petr@gmail.com</email>
            <organization>Jeffrey</organization>
            <organizationUrl>https://www.jeffrey-analyst.cafe/</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/petrbouda/jeffrey.git</connection>
        <developerConnection>scm:git:https://github.com/petrbouda/jeffrey.git</developerConnection>
        <url>https://github.com/petrbouda/jeffrey/tree/main</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Java 21 for the whole family. The one exception is jeffrey-tracing-scoped-value, the
          ScopedValue storage for the tracing API, which overrides this to 25; everything else,
          the API included, runs on 21.
        -->
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>6.1.3</junit.version>
        <!--
          Compile-time only: every framework dependency below is `provided`, so a
          consumer brings its own version and nothing here is imposed on them.
        -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <duckdb.version>1.5.5.1</duckdb.version>
        <mybatis.version>3.5.19</mybatis.version>
        <grpc.version>1.84.0</grpc.version>
        <protobuf.version>4.36.1</protobuf.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              gRPC's own poms skew: grpc-inprocess 1.81.0 depends on grpc-core 1.80.0, which
              mismatches grpc-api and fails at runtime with an AbstractMethodError. The BOM pins
              every gRPC artifact to one version.
            -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jeffrey-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jeffrey-tracing-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jeffrey-tracing-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jeffrey-tracing-api</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jeffrey-tracing-scoped-value</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jeffrey-tracing-thread-local</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <!--
              Staging-only release profile. Maven produces the jar + sources + javadoc
              for every module and deploys them into a local staging repository
              (target/staging-deploy, via -DaltDeploymentRepository). Signing and the
              actual upload to Maven Central are handled by JReleaser (`jreleaser deploy`,
              see jreleaser.yml), which replaced central-publishing-maven-plugin +
              maven-gpg-plugin.
            -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <stylesheet>java</stylesheet>
                            <doclint>none</doclint>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cafe.jeffrey-analyst</groupId>
        <artifactId>jeffrey-tracing-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jeffrey-tracing-grpc</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>gRPC client and server interceptors emitting Jeffrey exchange events, with the span re-entered on every callback</description>
    <!-- Explicit: Maven Central rejects children that inherit a url with the artifactId appended. -->
    <url>https://github.com/petrbouda/jeffrey</url>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jeffrey-events</artifactId>
        </dependency>
        <!-- provided: the application already has the gRPC runtime it is instrumenting. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jeffrey-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The instrumentation leaves the storage to the application; its tests need one. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jeffrey-tracing-thread-local</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

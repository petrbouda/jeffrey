<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cafe.jeffrey-analyst</groupId>
        <artifactId>jeffrey-tracing-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--
      The span in progress kept in a ScopedValue: the binding is scoped to the body by
      construction and is inherited by structured concurrency. The only module of the family
      that needs Java 25, and an explicit opt-in: nothing in the family depends on it, so it only
      reaches a JVM whose application added it - a Java 25 one. Everything else, the Spring Boot
      starter included, brings jeffrey-tracing-thread-local.
    -->
    <artifactId>jeffrey-tracing-scoped-value</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ScopedValue storage for the Jeffrey Tracer (Java 25+)</description>
    <!-- Explicit: Maven Central rejects children that inherit a url with the artifactId appended. -->
    <url>https://github.com/petrbouda/jeffrey</url>

    <properties>
        <!-- ScopedValue is final from Java 25 (JEP 506). -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jeffrey-tracing-api</artifactId>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jeffrey-tracing-api</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

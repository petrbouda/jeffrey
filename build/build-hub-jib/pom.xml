<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>build</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>build-hub-jib</artifactId>

    <properties>
        <mainClass>cafe.jeffrey.hub.core.HubApplication</mainClass>
        <finalName>jeffrey-hub</finalName>
        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>
        <!-- The jeffrey-jib version this image is built with, and therefore the payloadVersion the
             extension resolves. Both come from this reactor: release-hub.yml installs the extension
             and, behind the `payload` profile, the jeffrey-jib-payload-jar / -profiler artifacts
             built from THIS release's own provisioner.jar and the pinned async-profiler — the hub
             image never waits on a jeffrey-jib release reaching Maven Central. -->
        <jeffrey-jib-maven.version>1.0-SNAPSHOT</jeffrey-jib-maven.version>
        <image.from>eclipse-temurin:25-jdk</image.from>
        <image.to>petrbouda/jeffrey-hub:${project.version}</image.to>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>core-hub</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>cafe.jeffrey-analyst</groupId>
                        <artifactId>jeffrey-jib-maven</artifactId>
                        <version>${jeffrey-jib-maven.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <from>
                        <image>${image.from}</image>
                        <!-- Multi-arch manifest. Jib layers are not per-platform, so whatever the
                             jeffrey-jib extension bakes ships in both images; that is why this image
                             uses the arch-neutral provisioner jar rather than the native binary
                             (see the extension configuration below). -->
                        <platforms>
                            <platform>
                                <architecture>amd64</architecture>
                                <os>linux</os>
                            </platform>
                            <platform>
                                <architecture>arm64</architecture>
                                <os>linux</os>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <image>${image.to}</image>
                    </to>
                    <container>
                        <mainClass>${mainClass}</mainClass>
                        <ports>
                            <port>8080</port>
                            <port>9090</port>
                        </ports>
                        <!-- Image-level default: profiling off. K8s pod env overrides to "true" to enable. -->
                        <environment>
                            <JEFFREY_ENABLED>false</JEFFREY_ENABLED>
                        </environment>
                        <!-- Empty: let the jeffrey-jib wrapper own JVM configuration via the argfile.
                             Per JeffreyBuildPlanExtender javadoc, JVM flags here would be moved into CMD
                             and applied AFTER the argfile, silently overriding profiling settings. -->
                        <jvmFlags/>
                    </container>
                    <pluginExtensions>
                        <pluginExtension>
                            <implementation>cafe.jeffrey.jib.maven.JeffreyJibMavenExtension</implementation>
                            <configuration implementation="cafe.jeffrey.jib.JeffreyJibConfig">
                                <!-- enabled=true (default): wrapper layer is installed and ENTRYPOINT is rewritten.
                                     jeffreyHome / configs remain unset — those are deployment-specific (shared
                                     volume mount, ConfigMap path) and provided by the operator via pod env.

                                     The extension bakes the provisioner and async-profiler under /opt/jeffrey,
                                     so jeffrey-hub's self-profiling needs nothing from the shared volume.

                                     provisionerSource=jar rather than the `native` default: this image is
                                     multi-arch and Jib layers are not per-platform, so the native binary would
                                     ship both architectures (~86 MB) in every image. The jar is one arch-neutral
                                     file of ~4 MB, and it runs on the application's own JVM — which here is the
                                     JDK 25 base image, exactly what the jar is compiled for. -->
                                <provisionerSource>jar</provisionerSource>
                                <payloadVersion>${jeffrey-jib-maven.version}</payloadVersion>
                            </configuration>
                        </pluginExtension>
                    </pluginExtensions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

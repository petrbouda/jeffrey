<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>build</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>build-hub-jib</artifactId>

    <properties>
        <mainClass>cafe.jeffrey.hub.core.HubApplication</mainClass>
        <finalName>jeffrey-hub</finalName>
        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>
        <jeffrey-jib-maven.version>1.0-SNAPSHOT</jeffrey-jib-maven.version>
        <image.from>eclipse-temurin:25-jdk</image.from>
        <image.to>petrbouda/jeffrey-hub:${project.version}</image.to>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>core-hub</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>cafe.jeffrey-analyst</groupId>
                        <artifactId>jeffrey-jib-maven-native</artifactId>
                        <version>${jeffrey-jib-maven.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <from>
                        <image>${image.from}</image>
                        <!-- Multi-arch manifest. Jib layers are not per-platform, so whatever the
                             jeffrey-jib extension bakes ships in both images; that is why this image
                             uses the jar flavour of the extension (see the plugin dependency above). -->
                        <platforms>
                            <platform>
                                <architecture>amd64</architecture>
                                <os>linux</os>
                            </platform>
                            <platform>
                                <architecture>arm64</architecture>
                                <os>linux</os>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <image>${image.to}</image>
                    </to>
                    <container>
                        <mainClass>${mainClass}</mainClass>
                        <ports>
                            <port>8080</port>
                            <port>9090</port>
                        </ports>
                        <environment>
                            <JEFFREY_ENABLED>false</JEFFREY_ENABLED>
                        </environment>
                        <jvmFlags/>
                    </container>
                    <pluginExtensions>
                        <pluginExtension>
                            <implementation>cafe.jeffrey.jib.maven.JeffreyJibMavenExtension</implementation>
                        </pluginExtension>
                    </pluginExtensions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

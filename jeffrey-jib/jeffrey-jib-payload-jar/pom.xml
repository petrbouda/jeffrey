<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey-analyst</groupId>
        <artifactId>jeffrey-jib</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeffrey-jib-payload-jar</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>The provisioner jar and async-profiler, baked into application images by the jeffrey-jib-*-jar flavours of the Jeffrey JIB extension.</description>
    <url>https://github.com/petrbouda/jeffrey</url>

    <!--
      One jar carrying every binary the jar flavour bakes, under jeffrey-payload/:
      provisioner.jar, libasyncProfiler-linux-amd64.so, libasyncProfiler-linux-arm64.so.
      CI stages them into src/main/payload/jeffrey-payload/ before packaging; that directory is a
      resource root with filtering off, so nothing rewrites a binary. payload.properties, which the
      extension reads to learn what the jar carries and where it came from, lives in the ordinary
      resources directory and is filtered.
      The holder class exists because Maven Central requires sources and javadoc jars for every
      artifact; the extension never touches it.
    -->
    <properties>
        <payload.dir>${project.basedir}/src/main/payload</payload.dir>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${payload.dir}</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/.gitkeep</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>payload-staged</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- A release that forgot to stage a binary must fail here rather
                                     than publish a payload that breaks every consumer. -->
                                <requireFilesExist>
                                    <files>
                                        <file>${payload.dir}/jeffrey-payload/provisioner.jar</file>
                                        <file>${payload.dir}/jeffrey-payload/libasyncProfiler-linux-amd64.so</file>
                                        <file>${payload.dir}/jeffrey-payload/libasyncProfiler-linux-arm64.so</file>
                                    </files>
                                </requireFilesExist>
                                <!-- Recorded in payload.properties and printed by the extension at
                                     build time: the only place a consumer can see which Jeffrey
                                     release a jeffrey-jib payload actually bundles. -->
                                <requireProperty>
                                    <property>jeffrey.release</property>
                                    <regex>^v[0-9][0-9A-Za-z.+-]*$</regex>
                                    <regexMessage>jeffrey.release must be the Jeffrey release tag the provisioner was downloaded from, e.g. -Djeffrey.release=v0.13.22</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

# The Volume Scheduler's image: a GraalVM native image (petrbouda/volume-scheduler:<version>), its
# only distribution.
#
# Build from the repository root (the reactor needs every module's pom):
#   docker build -f docker/Dockerfile-volume-scheduler -t volume-scheduler .
#
# The image is built for the platform it is built on: native-image does not cross-compile, so the
# release builds amd64 and arm64 on their own runners and joins them under one tag
# (.github/workflows/release-volume-scheduler.yml).
#
# The binary takes the runtime options a native image understands ahead of the application's own
# arguments, e.g. a heap cap:  docker run petrbouda/volume-scheduler:<version> -Xmx64m
# Application properties come in as usual; the volume's path is required:
#   JEFFREY_VOLUMESCHEDULER_VOLUME_PATH=/mnt/jeffrey  or  --jeffrey.volume-scheduler.volume.path=/mnt/jeffrey

ARG GRAALVM_IMAGE=ghcr.io/graalvm/native-image-community:25
# glibc of the runtime must be at least the builder's (Oracle Linux 10: 2.39; Debian 13: 2.41).
ARG RUNTIME_IMAGE=gcr.io/distroless/base-debian13

FROM ${GRAALVM_IMAGE} AS builder

ARG MAVEN_VERSION=3.9.11

RUN curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
        | tar -xz -C /opt
ENV PATH="/opt/apache-maven-${MAVEN_VERSION}/bin:${PATH}"

WORKDIR /build
COPY . .

# Only the volume scheduler's part of the reactor: shared/volume, the volume-scheduler
# module and build-volume-scheduler-native (Spring AOT + native-image). No frontend, no Microscope.
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -q -pl build/build-volume-scheduler-native -am -Pnative package -DskipTests

FROM ${RUNTIME_IMAGE}

# Runs as root: the volume scheduler deletes and compresses whatever the profiled
# applications wrote to the shared volume, under whichever uid they ran.
COPY --from=builder /build/build/build-volume-scheduler-native/target/volume-scheduler /app/volume-scheduler

EXPOSE 8080
ENTRYPOINT ["/app/volume-scheduler"]

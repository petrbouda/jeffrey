# =============================================================================
# Jeffrey EventStreamingService — Manual Replay gRPC Client
# =============================================================================

@host = localhost:443
@workspaceId = workspace-id
@projectId = project-id
@sessionId = session-id

### 1. Replay available finished recordings
# Reads the recording files available when the request starts, then completes.
# The session may still be running; its current unfinished file is not included.
GRPC {{host}}/jeffrey.hub.api.v1.EventStreamingService/ReplayStreaming
Content-Type: application/json

{
  "sessionId": "{{sessionId}}",
  "eventTypes": ["jdk.CPULoad", "jdk.GarbageCollection"]
}

### 2. Scoped read-only replay with coverage metadata (used by MCP)
# Requires the session to belong to the specified workspace and project.
# The first batch acknowledges scope; the terminal replayStatus reports sourceErrors.
GRPC {{host}}/jeffrey.hub.api.v1.EventStreamingService/ScopedReplayStreaming
Content-Type: application/json

{
  "workspaceId": "{{workspaceId}}",
  "projectId": "{{projectId}}",
  "sessionId": "{{sessionId}}",
  "eventTypes": ["jdk.GarbageCollection", "jdk.GCHeapSummary"]
}

### 3. Replay a bounded time range
# Replace these epoch-millisecond bounds with a window in the selected session.
GRPC {{host}}/jeffrey.hub.api.v1.EventStreamingService/ScopedReplayStreaming
Content-Type: application/json

{
  "workspaceId": "{{workspaceId}}",
  "projectId": "{{projectId}}",
  "sessionId": "{{sessionId}}",
  "eventTypes": ["jdk.GCHeapSummary"],
  "startTime": 1759795200000,
  "endTime": 1759795260000
}

### 4. Empty event selection — expect INVALID_ARGUMENT
GRPC {{host}}/jeffrey.hub.api.v1.EventStreamingService/ReplayStreaming
Content-Type: application/json

{
  "sessionId": "{{sessionId}}",
  "eventTypes": []
}

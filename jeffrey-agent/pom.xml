<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeffrey-agent</artifactId>

    <!--
      The Java agent the provisioner attaches with -javaagent, so a profiled application reports
      liveness without carrying jeffrey-heartbeat itself. Heartbeat only: it touches no application
      bytecode.

      Its one dependency is jeffrey-heartbeat-core, the same dependency-free loop jeffrey-heartbeat
      runs, shaded in and relocated below. Nothing else, on purpose: the jar is appended to the
      system class path of every application it attaches to, so anything it brought along would be
      a version that application did not choose. It logs through System.Logger for the same reason.
      The jar is not distributed on its own; jeffrey-provisioner embeds it and writes it out per
      session.
    -->
    <properties>
        <!-- Pinned: unlike the jar plugin, shade has no version in Maven's super-POM. -->
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-heartbeat-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The oldest release a profiled application runs on, the same floor as the utilities. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <!--
              The core goes into the agent jar under the agent's own package. Unrelocated it would
              sit on the system class path beside, and win parent-first delegation over, the copy an
              application carrying jeffrey-heartbeat ships — a profiler must never re-version the
              thing it profiles. Replaces the main artifact, which is the jar the provisioner embeds.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>cafe.jeffrey.heartbeat.core</pattern>
                                    <shadedPattern>cafe.jeffrey.agent.shaded.heartbeat.core</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>cafe.jeffrey.agent.JeffreyAgent</Premain-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

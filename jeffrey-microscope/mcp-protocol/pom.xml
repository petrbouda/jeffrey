<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>jeffrey-microscope</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-protocol</artifactId>
    <description>
        The MCP 2026-07-28 protocol and nothing else: request validation, the transport-neutral
        dispatcher, the tool/prompt/resource/completion SPI, the tasks, skills and input-request
        extensions, and the output-schema tooling. No Jeffrey type and no Spring: jeffrey-microscope's
        mcp-server adapts it (ModuleBoundaryTest holds that).
    </description>

    <dependencies>
        <!-- JSON: the wire itself. Jackson annotations come with databind. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              The generic test helpers - McpTestRequests (the modern 2026-07-28 request every JSON-RPC
              test sends), McpSchemaConformance and McpTestFeatures - ship as a test-jar, so mcp-server
              and core-microscope build the same requests and check the same schemas. They live in the
              .testing package: a package of the main module on another module's classpath would be split.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

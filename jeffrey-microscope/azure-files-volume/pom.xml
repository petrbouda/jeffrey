<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>jeffrey-microscope</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>azure-files-volume</artifactId>
    <description>
        The recording volume read straight from an Azure file share (SMB or NFS) through the Azure
        Storage SDK: the shared/volume storage port over the Azure Files REST API.
    </description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>volume</artifactId>
        </dependency>
        <!-- AzureFilesAddress, AzureFilesProtocol, AzureFilesAuth -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>microscope-model</artifactId>
        </dependency>
        <!-- Its default Netty transport is left out: Microscope's gRPC carries its own Netty, and
             the JDK's HttpClient needs nothing that could clash with it -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-file-share</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-core-http-jdk-httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- The hub clients over this volume, end to end, against a share written as the provisioner writes -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>volume-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>jeffrey-microscope</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>core-microscope</artifactId>

    <properties>
        <mainClass>cafe.jeffrey.microscope.core.MicroscopeApplication</mainClass>
        <finalName>jeffrey</finalName>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>microscope-model</artifactId>
        </dependency>
        <dependency>
            <groupId>cafe.jeffrey</groupId>
            <artifactId>notifications</artifactId>
        </dependency>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Platform modules (formerly transitive via platform-core) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>microscope-core-sql-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>recording-storage-api</artifactId>
        </dependency>

        <!-- Profile management (for ProfilesManager, CommonProjectManager, etc.) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>profile-management</artifactId>
        </dependency>

        <!-- MCP server machinery (JSON-RPC envelope, @Tool toolsets) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mcp-server</artifactId>
        </dependency>

        <!-- Third-party -->
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-events</artifactId>
        </dependency>
        <!--
          Replaces the hand-written JFR HTTP filter this module used to carry: the
          starter registers it, and jeffrey.tracing.* below keeps the same URL
          patterns, ordering and parameter capture the filter had.
        -->
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-tracing-spring-boot-starter</artifactId>
        </dependency>

        <!-- gRPC remote clients (brings in hub-api + grpc-netty transitively) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>grpc-client</artifactId>
        </dependency>

        <!-- Shared remote-workspace clients/DTOs/managers (extracted from core) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>hub-client</artifactId>
        </dependency>
        <!-- Shared recording store + remote download machinery (extracted from core) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>recordings-core</artifactId>
        </dependency>
        <!-- Shared hub-browser controllers (hubs/workspaces/projects/instances/repository/download/recordings) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>hubs</artifactId>
        </dependency>
        <!-- Shared version controller (GET /api/internal/version) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>version</artifactId>
        </dependency>

        <!-- Frontend -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>pages-microscope</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>exec-maven-plugin</artifactId>
                <groupId>org.codehaus.mojo</groupId>
            </plugin>

            <!--
                The MCP prompts are the plugin's skills. Copied in at build time rather than kept as a
                second copy in this module: a client with the plugin reads the files themselves, and a
                client that cannot take a plugin reads them over the protocol, and the two must not
                drift apart. One source, two ways of reaching it.
            -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-mcp-prompts</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/mcp-prompts</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../jeffrey-claude-plugin/skills</directory>
                                    <includes>
                                        <include>*/SKILL.md</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>

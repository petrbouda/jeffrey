<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>jeffrey-microscope</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>hubs</artifactId>

    <dependencies>
        <!-- Remote gRPC client wrappers + DTOs + managers (RemoteInstancesManager, RepositoryManager, ...) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>hub-client</artifactId>
        </dependency>
        <!-- RecordingsCoreManager + download machinery (DownloadTask, DownloadTaskRegistry, ...) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>recordings-core</artifactId>
        </dependency>
        <!-- RecordingGroup / RecordingTag persistence model types used by the recordings DTOs -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>microscope-core-persistence-api</artifactId>
        </dependency>
        <!-- Models (Recording, ProjectInstanceInfo, ...), IDGenerator, Exceptions, Schedulers -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>microscope-model</artifactId>
        </dependency>
        <!-- Spring Web: ResponseEntity, Resource, MultipartFile, SseEmitter, StreamingResponseBody -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- @Configuration / @Bean for HubsFeatureConfiguration -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Jackson 3 (tools.jackson) for JSON binding of request/response DTOs -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>profiles</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>heap-dump</artifactId>

    <dependencies>
        <dependency>
            <groupId>cafe.jeffrey</groupId>
            <artifactId>notifications</artifactId>
        </dependency>
        <!-- Project dependencies -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>common-profile</artifactId>
        </dependency>

        <!-- shared/persistence brings in jeffrey-events (JFR JDBC event types)
             plus the GroupLabel enum. Spring JDBC lands on the classpath
             transitively but is unused here — heap-dump operates on raw
             DuckDBConnection + DuckDBAppender. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>persistence</artifactId>
        </dependency>

        <!-- DuckDB JDBC for the heap-dump-index sibling database (.idx.duckdb). -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
        </dependency>

        <!-- lz4-java bundles XXHash64 — used as a fast non-cryptographic hash
             for grouping byte-identical instance contents in
             DuplicateObjectAnalyzer. -->
        <dependency>
            <groupId>at.yawk.lz4</groupId>
            <artifactId>lz4-java</artifactId>
        </dependency>

        <!-- Eclipse Collections — primitive-specialised maps/sets/lists used
             by the HPROF walkers to avoid Long-boxing on object ids. The impl
             artifact pulls eclipse-collections-api in transitively. -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Jackson for JSON serialization -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JfrRecordings/SpansAssert: the index-build phases are asserted through a real flight
             recording, because a span's parentage is only observable in what JFR actually committed. -->
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-tracing-test</artifactId>
        </dependency>
    </dependencies>
</project>

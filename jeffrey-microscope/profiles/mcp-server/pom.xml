<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>profiles</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-server</artifactId>
    <description>MCP (Model Context Protocol) server machinery: JSON-RPC envelope and @Tool-driven toolsets</description>

    <dependencies>
        <!-- Tracer: every MCP tool invocation is recorded as a span -->
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-events</artifactId>
        </dependency>
        <!-- Where the Tracer keeps the span in progress; Jeffrey runs on Java 25, so the ScopedValue one. -->
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-tracing-scoped-value</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring AI - the @Tool/@ToolParam annotations and ToolUtils the toolsets reflect over.
             spring-ai-model is where those live; the chat client would only add machinery for calling
             a provider, which Jeffrey never does. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- ResponseEntity for the JSON-RPC endpoint base class. spring-web alone: this module owns
             the protocol, not the mapping, so it needs no servlet container and no MVC. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Jeffrey dependencies -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

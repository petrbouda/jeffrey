<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cafe.jeffrey</groupId>
        <artifactId>jeffrey-microscope</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-server</artifactId>
    <description>Jeffrey's MCP module: the 2026-07-28 protocol types and SPI, and the @Tool adapter over them (reflection, profile scoping, tool hints and findings)</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!-- Tracer: every MCP tool invocation is recorded as a span -->
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-events</artifactId>
        </dependency>
        <!-- Where the Tracer keeps the span in progress; Jeffrey runs on Java 25, so the ScopedValue one. -->
        <dependency>
            <groupId>cafe.jeffrey-analyst</groupId>
            <artifactId>jeffrey-tracing-scoped-value</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring AI - the @Tool/@ToolParam annotations and ToolUtils the toolsets reflect over.
             spring-ai-model is where those live; the chat client would only add machinery for calling
             a provider, which Jeffrey never does. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- ResponseEntity for the JSON-RPC endpoint base class. spring-web alone: this module adapts
             the protocol to Spring but leaves the mapping to the controller, so it needs no servlet
             container and no MVC. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- JSON: the protocol types are the wire itself. Jackson annotations come with databind. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              McpNextToolConformance and McpTestToolsets, Jeffrey's own test helpers, ship as a test-jar
              so core's tool tests check follow-up calls and build toolsets the same way.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- ToolInvocationTest reads the tool-call span back with a JFR recording; the module itself only emits. -->
                    <argLine>--add-reads cafe.jeffrey.microscope.mcp.server=jdk.jfr</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
